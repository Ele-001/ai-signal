{
  "description": "AI红路灯 local status indicator. Review these commands before trusting them.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/path/to/ai-signal/integrations/codex_hook.py' --event UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
