{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Signal",
  "version": "0.1.3",
  "identifier": "io.aisignal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "AI Signal",
        "url": "index.html?view=widget",
        "width": 150,
        "height": 334,
        "minWidth": 105,
        "minHeight": 233,
        "x": 48,
        "y": 96,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "panel",
        "title": "AI Signal",
        "url": "index.html?view=panel",
        "width": 780,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "backgroundColor": "#f5f5f7",
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "desktop"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A floating traffic light for your AI work",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
